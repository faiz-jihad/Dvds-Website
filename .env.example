# AZ Rayan DVDs Environment Configuration (Production Template)

# Required Supabase Backend Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production Mode Settings
VITE_ENABLE_DEMO_ADMIN=false
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=

# Stripe Public Checkout Key (Publishable Key for browser checkout)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# Google OAuth Credentials (configured in Supabase Dashboard & Google Cloud Console)
CLIENT_ID_GOOGLE=your_google_client_id.apps.googleusercontent.com
SECRET_ID_GOOGLE=your_google_client_secret
