# AZ Rayan DVDs — Environment Variables Reference
# Copy this file to .env and fill in real values. Never commit .env to git.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Browser / Frontend (prefixed with VITE_)
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Server / API (used by /api/* handlers only, never exposed to browser)
# Required for all checkout, order creation, and payment recording endpoints.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─────────────────────────────────────────────────────────────────────────────
# Base Site URL
# Used to build redirect URLs for Stripe and PayPal (return_url / cancel_url).
# ─────────────────────────────────────────────────────────────────────────────
SITE_URL=https://dvds-zone.co.uk

# ─────────────────────────────────────────────────────────────────────────────
# Email System & Automated Notifications (Transactional & Reports)
# ─────────────────────────────────────────────────────────────────────────────
# Sender address shown on customer receipts and admin notifications
EMAIL_FROM="DVDs Zone <info@dvds-zone.co.uk>"

# Primary Local SMTP (Postfix on VPS localhost: 127.0.0.1:25)
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_ENABLED=true
# Optional authentication if required by relay (local Postfix loopback requires none)
# SMTP_USER=
# SMTP_PASS=

# Failover / Alternative Email Providers:
# - Mailtrap API:
# MAILTRAP_API_TOKEN=your_mailtrap_api_token
# MAILTRAP_INBOX_ID=your_inbox_id

# Alternative Email Providers (Optional failover/alternatives):
# - Resend: https://resend.com
# RESEND_API_KEY=re_your_resend_api_key
# - SendGrid: https://sendgrid.com
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# - Brevo / Sendinblue (Free 300 emails/day, no credit card): https://brevo.com
# BREVO_API_KEY=xkeysib-your_brevo_api_key
# - Postmark: https://postmarkapp.com
# POSTMARK_SERVER_TOKEN=your_postmark_server_token
# Note: If no email provider key is configured, emails log safely in simulated mode.

# Destination for automated orders, payment proof alerts, contact inquiries & business reports
ADMIN_EMAIL=azrayanltd@gmail.com

# Secret key to authenticate Vercel Cron scheduled report invocations
CRON_SECRET=your_secure_cron_secret

# ─────────────────────────────────────────────────────────────────────────────
# Stripe — Card payments, Visa debit/credit, Apple Pay, Google Pay
# Never prefix secret keys with VITE_. Publishable key is used by the frontend
# only for informational checks (not for raw card collection in this project).
#
# IMPORTANT — Apple Pay setup:
#   1. Register your domain in Stripe Dashboard:
#      Settings > Payment methods > Apple Pay > Register domain
#   2. No domain association file is needed when using Stripe Hosted Checkout.
#   3. Apple Pay only appears on Safari / iOS / macOS with a card enrolled.
# ─────────────────────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────────────────────
# PayPal — PayPal Checkout (buyer redirects to PayPal, returns to site)
# Create a REST API app at https://developer.paypal.com/
# ─────────────────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox             # sandbox | live
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ─────────────────────────────────────────────────────────────────────────────
# Bank Transfer
# Configure receiving account and instructions in Admin > Store Settings >
# Payment methods. Bank transfer starts disabled by default.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth & Search Console Verification
# ─────────────────────────────────────────────────────────────────────────────
CLIENT_ID_GOOGLE=your-google-client-id.apps.googleusercontent.com
SECRET_ID_GOOGLE=your-google-client-secret
# Google Search Console HTML tag verification code (without quotes, e.g. AbCdEf123456...)
GOOGLE_SITE_VERIFICATION=your-google-site-verification-token
# Google Business Profile / Google Reviews URL
VITE_GOOGLE_REVIEW_URL=https://g.page/r/CcbYihBj8jECEBM/review

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare — Edge Security, Turnstile & Zone Management
# ─────────────────────────────────────────────────────────────────────────────
# Turnstile CAPTCHA-free bot verification (optional for login/register/contact)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Scoped API Token for automated cache purging or DNS management (server only)
# Permission required: Zone.Cache Purge, Zone.DNS (Read/Write)
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_API_TOKEN=your-scoped-cloudflare-api-token
