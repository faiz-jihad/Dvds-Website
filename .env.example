# AZ Rayan DVDs Environment Configuration

# Required operational backend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe secret values and SITE_URL belong in Supabase Edge Function secrets,
# never in the frontend .env file.

# Optional local-only login preview. Disabled unless explicitly set to true.
VITE_ENABLE_DEMO_ADMIN=false
VITE_DEMO_ADMIN_EMAIL=admin@azrayan.co.uk
VITE_DEMO_ADMIN_PASSWORD=replace-for-local-preview
