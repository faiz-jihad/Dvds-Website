# AZ Rayan DVDs Environment Configuration (Production Template)

# Supabase Backend Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin requires a Supabase Auth account with profiles.role = admin or staff.

# Base Site URL
SITE_URL=https://azrayan.co.uk

# 1. Stripe Payment Gateway
# Never commit actual secret keys to git. Read strictly from environment.
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# 2. PayPal Checkout Gateway
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox             # Use 'sandbox' for testing, 'live' for production
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# 3. Company Bank Transfer (Barclays Bank UK)
# Defaults for AZ Rayan Ltd:
# Bank: Barclays Bank UK
# Sort Code: 20-00-00
# Account Number: 13894195

# Google OAuth Credentials (configured in Supabase Dashboard & Google Cloud Console)
CLIENT_ID_GOOGLE=your_google_client_id.apps.googleusercontent.com
SECRET_ID_GOOGLE=your_google_client_secret
